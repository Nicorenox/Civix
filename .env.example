# Copia este archivo como .env en el servidor antes de iniciar Docker Compose.
DJANGO_SECRET_KEY=reemplazar-por-una-clave-aleatoria-larga-y-unica
DJANGO_DEBUG=0
# Sustituye los ejemplos por el DNS EC2 real, la IP elástica y tu subdominio DuckDNS.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ec2-203-0-113-10.compute-1.amazonaws.com,203.0.113.10,civix-equipo.duckdns.org
# Incluye origen y protocolo; agrega HTTPS cuando instales certificado TLS.
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10,http://civix-equipo.duckdns.org,https://civix-equipo.duckdns.org
POSTGRES_DB=civix
POSTGRES_USER=civix
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEMO_PROVISION_TOKEN=replace-with-a-random-64-character-service-token
PARTNER_API_URL=http://flask_notificaciones:5000/api/v2/aliado/resumen/
THIRD_PARTY_API_URL=https://api.open-meteo.com/v1/forecast?latitude=4.7110&longitude=-74.0721&current=temperature_2m,precipitation,wind_speed_10m&timezone=America%2FBogota
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
